{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oge-room-server",
  "main": "worker/room-server.js",
  "compatibility_date": "2026-09-03",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "LIMITER", "class_name": "JoinLimiter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["JoinLimiter"] }
  ]
}
